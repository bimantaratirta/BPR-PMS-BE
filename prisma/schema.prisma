// V2 

model Region {
  id         String    @id @default(uuid())
  region     String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  branches Branch[] @relation("RegionBranches")
  user     User[]   @relation("UserRegions")

  @@map("regions")
}

model Branch {
  id         String    @id @default(uuid())
  branch     String
  region_id  String
  address    String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  region Region @relation("RegionBranches", fields: [region_id], references: [id])
  user   User[] @relation("UserBranches")

  @@map("branches")
}

model Employee {
  id              String    @id @default(uuid())
  company_name    String?
  company_address String?
  company_phone   String?
  position        String?
  work            String? // shown in report
  salary          Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  customer Customer[] @relation("EmployeeCustomer")

  @@map("employees")
}

model NonEmployee {
  id               String    @id @default(uuid())
  salary_frequency String?
  work             String? // shown in report
  salary           Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  customer Customer[] @relation("NonEmployeeCustomer")

  @@map("non_employees")
}

model Business {
  id             String    @id @default(uuid())
  business_type  String? // shown in report
  employee_count Int?
  revenue        Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  customer Customer[] @relation("BusinessCustomer")

  @@map("businesses")
}

model Customer {
  id              String    @id @default(uuid())
  name            String?
  ktp_number      String?
  date_of_birth   DateTime?
  address         String?
  rt_rw           String?
  village         String?
  phone_number    String?
  employee_id     String?
  non_employee_id String?
  business_id     String?
  created_by      String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  user         User?        @relation("UserCustomer", fields: [created_by], references: [id])
  employee     Employee?    @relation("EmployeeCustomer", fields: [employee_id], references: [id])
  non_employee NonEmployee? @relation("NonEmployeeCustomer", fields: [non_employee_id], references: [id])
  business     Business?    @relation("BusinessCustomer", fields: [business_id], references: [id])

  update_logs  CustomerUpdateLog[] @relation("CustomerUpdateLog")
  report Report[] @relation("CustomerReport")

  @@map("customers")
}

model CustomerUpdateLog {
  id          String   @id @default(uuid())
  customer_id String
  updated_by  String   // Bisa disesuaikan dengan ID user atau admin yang melakukan update
  updated_at  DateTime @default(now()) // Waktu ketika update terjadi
  changes     String   // Deskripsi perubahan yang dilakukan
  
  customer Customer @relation("CustomerUpdateLog", fields: [customer_id], references: [id]) // Menambahkan nama relasi yang sama


  @@map("customer_update_logs")
}


model Report {
  id                    String  @id @default(uuid())
  status                Status
  
  process               Process
  customer_id           String?
  lo_id                 String?
  slo_id                String?
  am_id                 String?
  customer_snapshot     Json
  employee_snapshot     Json?
  non_employee_snapshot Json?
  business_snapshot     Json?
  review_by_slo         DateTime?
  review_by_am          DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  lo              User?            @relation("UserReportLO", fields: [lo_id], references: [id])
  slo             User?            @relation("UserReportSLO", fields: [slo_id], references: [id])
  am              User?            @relation("UserReportAM", fields: [am_id], references: [id])
  customer        Customer?        @relation("CustomerReport", fields: [customer_id], references: [id])
  report_photo    ReportPhoto[]    @relation("ReportPhoto")
  review_customer ReviewCustomer? @relation("ReportReviewCustomer")
  evaluation      Evaluation?     @relation("ReportEvaluation")

  @@map("reports")
}

model ReportPhoto {
  id         String    @id @default(uuid())
  report_id  String
  url        String // public URL / signed URL
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  report Report @relation("ReportPhoto", fields: [report_id], references: [id])

  @@map("report_photos")
}

model ReviewCustomer {
  id              String    @id @default(uuid())
  status_review   Status_Review
  report_id       String    @unique
  review_identity Boolean?
  review_domicile Boolean?
  review_work     Boolean?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  report Report @relation("ReportReviewCustomer", fields: [report_id], references: [id])
  update_logs ReviewCustomerUpdateLog[] @relation("ReviewCustomerUpdateLog")

  @@map("review_customers")
}

model ReviewCustomerUpdateLog {
  id          String   @id @default(uuid())
  review_customer_id String
  updated_by  String   // Bisa disesuaikan dengan ID user atau admin yang melakukan update
  updated_at  DateTime @default(now()) // Waktu ketika update terjadi
  changes     String   // Deskripsi perubahan yang dilakukan
  
  review_customer ReviewCustomer @relation("ReviewCustomerUpdateLog", fields: [review_customer_id], references: [id]) // Menambahkan nama relasi yang sama


  @@map("review_customer_update_logs")
}

model Evaluation {
  id               String    @id @default(uuid())
  status_review    Status_Review
  report_id        String    @unique
  character        String?
  status_character Status?
  capacity         String?
  status_capacity  Status?
  condition        String?
  status_condition Status?
  capital          String?
  status_capital   Status?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  report            Report             @relation("ReportEvaluation", fields: [report_id], references: [id])
  review_evaluation ReviewEvaluation? @relation("EvaluationReviewEvaluation")
  update_logs       EvaluationUpdateLog[] @relation("EvaluationUpdateLog")

  @@map("evaluations")
}

model EvaluationUpdateLog {
  id          String   @id @default(uuid())
  evaluation_id String
  updated_by  String   // Bisa disesuaikan dengan ID user atau admin yang melakukan update
  updated_at  DateTime @default(now()) // Waktu ketika update terjadi
  changes     String   // Deskripsi perubahan yang dilakukan
  
  evaluation Evaluation @relation("EvaluationUpdateLog", fields: [evaluation_id], references: [id]) // Menambahkan nama relasi yang sama


  @@map("evaluation_update_logs")
}

model ReviewEvaluation {
  id               String    @id @default(uuid())
  status_review    Status_Review
  evaluation_id    String    @unique
  review_character Boolean?
  review_capacity  Boolean?
  review_condition Boolean?
  review_capital   Boolean?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  evaluation Evaluation @relation("EvaluationReviewEvaluation", fields: [evaluation_id], references: [id])
  update_logs ReviewEvaluationUpdateLog[] @relation("ReviewEvaluationUpdateLog")

  @@map("review_evaluations")
}

model ReviewEvaluationUpdateLog {
  id          String   @id @default(uuid())
  review_evaluation_id String
  updated_by  String   // Bisa disesuaikan dengan ID user atau admin yang melakukan update
  updated_at  DateTime @default(now()) // Waktu ketika update terjadi
  changes     String   // Deskripsi perubahan yang dilakukan
  
  evaluation ReviewEvaluation @relation("ReviewEvaluationUpdateLog", fields: [review_evaluation_id], references: [id]) // Menambahkan nama relasi yang sama


  @@map("review_evaluation_update_logs")
}

enum Status {
  GOOD
  BAD
}

enum Process {
  DECLINE_LO
  REVIEW_SLO
  DECLINE_REVIEW_SLO
  EVALUATION_SLO
  DECLINE_EVALUATION_SLO
  REVIEW_AM
  APPROVE_AM
  DECLINE_AM
}

enum Status_Review {
  DRAFT
  COMPLETED
}
